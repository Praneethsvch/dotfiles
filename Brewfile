# Everything the configs in this repo need. Installed by ./install.sh
# (Alacritty is not here: Homebrew disabled its cask, so it is a manual
# download - see README. git comes with the Xcode command line tools.)

# Core
brew "neovim"
brew "tmux"

# Shell (used by zsh/.zshrc)
brew "fzf"
brew "zoxide"
brew "eza"
brew "zsh-autosuggestions"
brew "cyme"              # `lsusb` alias

# Neovim plugin dependencies
brew "ripgrep"           # telescope live grep
brew "node"              # copilot, markdown-preview, some Mason servers
brew "tree-sitter-cli"   # nvim-treesitter (main branch) builds parsers with it

# Font used by alacritty.toml
cask "font-source-code-pro"
